#!/usr/bin/env oscript
#Использовать json

// tools/checks/check.os — резолвер проверок на дескрипторах.
//
// Использование:
//   oscript tools/checks/check.os --scenario <s> [--platform <p>] [--flavor <f>] [--dry-run]
//   oscript tools/checks/check.os --scenario <s> --build <ver:flavor> [--build …]
//   oscript tools/checks/check.os --tags "@tag1 @tag2" --platform <p> --flavor <f>
//   oscript tools/checks/check.os --feature <path> [--feature <path>…] --platform <p> --flavor <f>
//   oscript tools/checks/check.os --list
//
// Флаги:
//   --scenario <s>            именованный сценарий из scenarios/<s>.json
//   --tags "<@t1 @t2>"        ad-hoc whitelist тегов (→ СписокТеговОтбор)
//   --feature <path>          конкретная .feature (можно несколько)
//   --platform <ver[,ver]>    одна или несколько платформ (файлы platforms/<ver>.json)
//   --flavor <f[,f]>          один/несколько флейворов (файлы flavors/<f>.json)
//   --build <ver:flavor>      явная пара платформа:флейвор (можно несколько)
//   --language <ru|en>        опц. (отложено)
//   --watcher                 включить Watcher (по умолчанию включён)
//   --no-watcher              выключить Watcher
//   --list                    показать доступные сценарии/платформы/флейворы
//   --dry-run                 показать собранные ячейки и итоговые поля без запуска
//
// CWD внутри обёртки = tools/. Пути в дескрипторах — относительно tools/.

Перем КаталогCheck;      // .../tools/checks
Перем КаталогTools;      // .../tools

// ============================================================================
// Вспомогательные функции
// ============================================================================

Функция ЭтоLinux()
	Попытка
		ТипПл = Вычислить("(Новый СистемнаяИнформация).ТипПлатформы");
		Возврат ТипПл <> Вычислить("ТипПлатформы.Windows_x86")
			И ТипПл <> Вычислить("ТипПлатформы.Windows_x86_64");
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция АбсолютныйПуть(Знач Путь)
	Возврат (Новый Файл(Путь)).ПолноеИмя;
КонецФункции

Функция Кавычка()
	Возврат """";
КонецФункции

Функция ПрочитатьJSONФайл(Знач ПутьКФайлу)
	Ф = Новый Файл(ПутьКФайлу);
	Если НЕ Ф.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Чтение = Новый ЧтениеТекста(ПутьКФайлу, "UTF-8");
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();
	Парсер = Новый ПарсерJSON();
	Возврат Парсер.ПрочитатьJSON(Содержимое);
КонецФункции

Функция СохранитьJSONФайл(Знач Данные, Знач ПутьКФайлу)
	Парсер = Новый ПарсерJSON();
	Строка = Парсер.ЗаписатьJSON(Данные);
	Запись = Новый ЗаписьТекста(ПутьКФайлу, "UTF-8", Ложь);
	Запись.Записать(Строка);
	Запись.Закрыть();
КонецФункции

// ============================================================================
// Слияние дескрипторов
// ============================================================================

// Служебные ключи дескрипторов — НЕ попадают в итоговый VBParams
Функция СлужебныеКлючи()
	Рез = Новый Массив;
	Рез.Добавить("platformExcludeTags");
	Рез.Добавить("flavorExcludeTags");
	Рез.Добавить("selectTags");
	Рез.Добавить("baseExclude");
	Рез.Добавить("combos");
	Рез.Добавить("matrix");
	Рез.Добавить("_description");
	Рез.Добавить("_comment");
	Рез.Добавить("_overrides");
	Возврат Рез;
КонецФункции

Функция ЭтоСлужебныйКлюч(Ключ)
	Если Лев(Ключ, 1) = "_" Тогда
		Возврат Истина;
	КонецЕсли;
	Для каждого К Из СлужебныеКлючи() Цикл
		Если К = Ключ Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Слить два Соответствия: overlay победит (все ключи кроме служебных)
Функция СлитьСоответствия(Знач Базовое, Знач Наложение)
	Рез = Новый Соответствие;
	// Сначала копируем базовое
	Для каждого Пара Из Базовое Цикл
		Рез.Вставить(Пара.Ключ, Пара.Значение);
	КонецЦикла;
	// Поверх накладываем overlay, пропуская служебные ключи
	Если Наложение <> Неопределено Тогда
		Для каждого Пара Из Наложение Цикл
			Если НЕ ЭтоСлужебныйКлюч(Пара.Ключ) Тогда
				Рез.Вставить(Пара.Ключ, Пара.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Рез;
КонецФункции

// Добавить элементы из Исходный в Целевой (если уже есть — пропустить)
Процедура ДобавитьТеги(Целевой, Исходный)
	Если Исходный = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для каждого Тег Из Исходный Цикл
		Есть = Ложь;
		Для каждого Т Из Целевой Цикл
			Если Т = Тег Тогда
				Есть = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Есть Тогда
			Целевой.Добавить(Тег);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Разобрать строку тегов "--tags "@tag1 @tag2"" в массив
Функция РазобратьТеги(Знач СтрокаТегов)
	Рез = Новый Массив;
	Части = СтрРазделить(СтрокаТегов, " ", Ложь);
	Для каждого Ч Из Части Цикл
		Т = СтрЗаменить(Ч, "@", "");
		Т = СокрЛП(Т);
		Если Т <> "" Тогда
			Рез.Добавить(Т);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// ============================================================================
// Загрузка дескрипторов
// ============================================================================

Функция ЗагрузитьДефолты()
	Путь = КаталогCheck + "/defaults.json";
	Рез = ПрочитатьJSONФайл(Путь);
	Если Рез = Неопределено Тогда
		Сообщить("[ERROR] Не найден defaults.json: " + Путь);
		ЗавершитьРаботу(1);
	КонецЕсли;
	Возврат Рез;
КонецФункции

Функция ЗагрузитьДескриптор(Знач Подкаталог, Знач Имя)
	Путь = КаталогCheck + "/" + Подкаталог + "/" + Имя + ".json";
	Рез = ПрочитатьJSONФайл(Путь);
	Если Рез = Неопределено Тогда
		Сообщить("[ERROR] Дескриптор не найден: " + Путь);
		ЗавершитьРаботу(1);
	КонецЕсли;
	Возврат Рез;
КонецФункции

// Ключи build, в которых имена файлов-логов надо суффиксить при сплите
Функция ЛоговыеКлючи()
	Рез = Новый Массив;
	Рез.Добавить("ИмяФайлаЛогВыполненияСценариев");
	Рез.Добавить("ВыводитьСообщенияВФайл");
	Рез.Добавить("ПутьКФайлуДляВыгрузкиСтатусаВыполненияСценариев");
	Возврат Рез;
КонецФункции

// Вставить суффикс перед последним расширением: log8327.txt + part1 → log8327-part1.txt
Функция ВставитьСуффиксВИмяФайла(Знач Путь, Знач Суффикс)
	Поз = 0;
	Для Сч = 1 По СтрДлина(Путь) Цикл
		Если Сред(Путь, Сч, 1) = "." Тогда
			Поз = Сч;
		КонецЕсли;
	КонецЦикла;
	Если Поз = 0 Тогда
		Возврат Путь + "-" + Суффикс;
	КонецЕсли;
	Возврат Лев(Путь, Поз - 1) + "-" + Суффикс + Сред(Путь, Поз);
КонецФункции

// Части сплита для ячейки: scenario.split.parts если flavor входит в split.flavors,
// иначе массив с одним Неопределено (одна сборка без сплита).
Функция ЧастиСплита(Знач СценарийДанные, Знач ФлейворИмя)
	Рез = Новый Массив;
	Если СценарийДанные <> Неопределено Тогда
		Сплит = СценарийДанные["split"];
		Если Сплит <> Неопределено Тогда
			Подходит = Ложь;
			ФлейворыСплита = Сплит["flavors"];
			Если ФлейворыСплита <> Неопределено Тогда
				Для каждого Ф Из ФлейворыСплита Цикл
					Если Ф = ФлейворИмя Тогда
						Подходит = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Если Подходит Тогда
				Для каждого Ч Из Сплит["parts"] Цикл
					Рез.Добавить(Ч);
				КонецЦикла;
				Возврат Рез;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Рез.Добавить(Неопределено);
	Возврат Рез;
КонецФункции

// ============================================================================
// Построение build-Соответствия для одной ячейки (platform, flavor)
// ============================================================================

Функция СобратьBuild(Знач ПлатформаИмя, Знач ФлейворИмя, Знач СценарийДанные,
                      Знач ТегиОтбораДоп, Знач ФичиСписок, Знач ЯзыкИмя, Знач Часть)
	Дефолты   = ЗагрузитьДефолты();
	Платформа = ЗагрузитьДескриптор("platforms", ПлатформаИмя);
	Флейвор   = ЗагрузитьДескриптор("flavors", ФлейворИмя);

	// Слияние: defaults ← platform ← flavor
	Билд = СлитьСоответствия(Дефолты, Платформа);
	Билд = СлитьСоответствия(Билд, Флейвор);

	// language-оверлей (если задан)
	Если ЯзыкИмя <> "" Тогда
		ПутьЯз = КаталогCheck + "/language/" + ЯзыкИмя + ".json";
		ЯзДанные = ПрочитатьJSONФайл(ПутьЯз);
		Если ЯзДанные <> Неопределено Тогда
			Билд = СлитьСоответствия(Билд, ЯзДанные);
		КонецЕсли;
	КонецЕсли;

	// Подстановка КлиентыТестирования из платформы по запросу флейвора
	// (напр. flavor=web → взять _webКлиентыТестирования из дескриптора платформы)
	ОткудаКлиенты = Флейвор["_clientsFrom"];
	Если ОткудаКлиенты <> Неопределено Тогда
		КлиентыИзПлатформы = Платформа[ОткудаКлиенты];
		Если КлиентыИзПлатформы <> Неопределено Тогда
			Билд.Вставить("КлиентыТестирования", КлиентыИзПлатформы);
		КонецЕсли;
	КонецЕсли;

	// ИмяСборки
	ПрефИмени = ПлатформаИмя + " " + ФлейворИмя;
	Если СценарийДанные <> Неопределено Тогда
		Ключ = Билд["_scenario_name"];
		Если Ключ <> Неопределено Тогда
			ПрефИмени = ПрефИмени + " " + Ключ;
		КонецЕсли;
	КонецЕсли;
	Если Часть <> Неопределено Тогда
		ПрефИмени = ПрефИмени + " " + Часть["suffix"];
	КонецЕсли;
	Билд.Вставить("ИмяСборки", "Сборка " + ПрефИмени);

	// Теги отбора
	ТегиОтбора = Новый Массив;
	Если СценарийДанные <> Неопределено Тогда
		ДобавитьТеги(ТегиОтбора, СценарийДанные["selectTags"]);
	КонецЕсли;
	ДобавитьТеги(ТегиОтбора, ТегиОтбораДоп);
	Если ТегиОтбора.Количество() > 0 Тогда
		Билд.Вставить("СписокТеговОтбор", ТегиОтбора);
	КонецЕсли;

	// Фичи
	Если ФичиСписок.Количество() > 0 Тогда
		Билд.Вставить("СписокФичДляВыполнения", ФичиСписок);
	КонецЕсли;

	// Теги исключения
	ТегиИсключ = Новый Массив;
	Если СценарийДанные <> Неопределено Тогда
		ДобавитьТеги(ТегиИсключ, СценарийДанные["baseExclude"]);
	КонецЕсли;
	ДобавитьТеги(ТегиИсключ, Платформа["platformExcludeTags"]);
	ДобавитьТеги(ТегиИсключ, Флейвор["flavorExcludeTags"]);
	Если Часть <> Неопределено Тогда
		ДобавитьТеги(ТегиИсключ, Часть["exclude"]);
	КонецЕсли;
	Если ТегиИсключ.Количество() > 0 Тогда
		Билд.Вставить("СписокТеговИсключение", ТегиИсключ);
	КонецЕсли;

	// _overrides из сценария (специальные поля: КоличествоПопыток etc.)
	Если СценарийДанные <> Неопределено Тогда
		Оверрайды = СценарийДанные["_overrides"];
		Если Оверрайды <> Неопределено Тогда
			Для каждого Пара Из Оверрайды Цикл
				Билд.Вставить(Пара.Ключ, Пара.Значение);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	// Суффикс в именах лог-файлов, чтобы part1/part2 не перетирали друг друга
	Если Часть <> Неопределено Тогда
		Для каждого КлючЛога Из ЛоговыеКлючи() Цикл
			ТекЗнач = Билд[КлючЛога];
			Если ТекЗнач <> Неопределено Тогда
				Билд.Вставить(КлючЛога, ВставитьСуффиксВИмяФайла(ТекЗнач, Часть["suffix"]));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Билд;
КонецФункции

// ============================================================================
// --list
// ============================================================================

Процедура ВывестиСписок()
	Сообщить("Сценарии:");
	Файлы = НайтиФайлы(КаталогCheck + "/scenarios", "*.json", Ложь);
	Для каждого Ф Из Файлы Цикл
		Если Ф.ЭтоФайл() Тогда
			Имя = Лев(Ф.Имя, СтрДлина(Ф.Имя) - СтрДлина(".json"));
			Сообщить("  " + Имя);
		КонецЕсли;
	КонецЦикла;
	Сообщить("Платформы:");
	Файлы = НайтиФайлы(КаталогCheck + "/platforms", "*.json", Ложь);
	Для каждого Ф Из Файлы Цикл
		Если Ф.ЭтоФайл() Тогда
			Имя = Лев(Ф.Имя, СтрДлина(Ф.Имя) - СтрДлина(".json"));
			Сообщить("  " + Имя);
		КонецЕсли;
	КонецЦикла;
	Сообщить("Флейворы:");
	Файлы = НайтиФайлы(КаталогCheck + "/flavors", "*.json", Ложь);
	Для каждого Ф Из Файлы Цикл
		Если Ф.ЭтоФайл() Тогда
			Имя = Лев(Ф.Имя, СтрДлина(Ф.Имя) - СтрДлина(".json"));
			Сообщить("  " + Имя);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// ============================================================================
// --dry-run вывод
// ============================================================================

Процедура ВывестиDryRun(Знач Ячейки, Знач ТегиОтбораДоп, Знач ФичиСписок,
                         Знач СценарийИмя, Знач ЗапускатьWatcher)
	Парсер = Новый ПарсерJSON();
	Сообщить("=== DRY-RUN ===");
	Сообщить("ОС:              " + ?(ЭтоLinux(), "linux", "windows"));
	Сообщить("Сценарий:        " + ?(СценарийИмя <> "", СценарийИмя, "(нет)"));
	Сообщить("Watcher:         " + ?(ЗапускатьWatcher, "ON", "OFF"));
	Сообщить("Ячеек:           " + Ячейки.Количество());
	Для каждого Яч Из Ячейки Цикл
	Для каждого Часть Из ЧастиСплита(Яч["scenario"], Яч["flavor"]) Цикл
		Сообщить("");
		СуфТекст = ?(Часть <> Неопределено, " [" + Часть["suffix"] + "]", "");
		Сообщить("  platform=" + Яч["platform"] + " flavor=" + Яч["flavor"] + СуфТекст);
		БилдДанные = СобратьBuild(Яч["platform"], Яч["flavor"], Яч["scenario"],
		                           ТегиОтбораДоп, ФичиСписок, Яч["language"], Часть);
		Сообщить("    ВерсияПлатформы:      " + БилдДанные["ВерсияПлатформы"]);
		Сообщить("    КаталогФич:           " + БилдДанные["КаталогФич"]);
		Клиенты = БилдДанные["КлиентыТестирования"];
		Если Клиенты <> Неопределено И Клиенты.Количество() > 0 Тогда
			Сообщить("    ТипКлиента:           " + Клиенты[0]["ТипКлиента"]);
		КонецЕсли;
		ТегиО = БилдДанные["СписокТеговОтбор"];
		Если ТегиО <> Неопределено Тогда
			Сообщить("    СписокТеговОтбор:     " + Парсер.ЗаписатьJSON(ТегиО));
		КонецЕсли;
		ТегиИ = БилдДанные["СписокТеговИсключение"];
		Если ТегиИ <> Неопределено Тогда
			Сообщить("    СписокТеговИсключение:" + Парсер.ЗаписатьJSON(ТегиИ));
		КонецЕсли;
	КонецЦикла;
	КонецЦикла;
	ЗавершитьРаботу(0);
КонецПроцедуры

// ============================================================================
// Разбор аргументов командной строки
// ============================================================================

Функция ПарсАргументов()
	Рез = Новый Соответствие;
	Рез.Вставить("scenario",    "");
	Рез.Вставить("tags",        "");
	Рез.Вставить("features",    Новый Массив);
	Рез.Вставить("platforms",   Новый Массив);
	Рез.Вставить("flavors",     Новый Массив);
	Рез.Вставить("builds",      Новый Массив);  // пары "ver:flavor"
	Рез.Вставить("language",    "");
	Рез.Вставить("watcher",     Истина);   // по умолчанию ON
	Рез.Вставить("list",        Ложь);
	Рез.Вставить("dryrun",      Ложь);
	Рез.Вставить("help",        Ложь);

	ПредыдущийФлаг = "";
	Для каждого Арг Из АргументыКоманднойСтроки Цикл
		А = СокрЛП(СтрЗаменить(Арг, Символ(13), ""));
		Если А = "--list" Тогда
			Рез.Вставить("list", Истина);
		ИначеЕсли А = "--dry-run" Тогда
			Рез.Вставить("dryrun", Истина);
		ИначеЕсли А = "--watcher" Тогда
			Рез.Вставить("watcher", Истина);
		ИначеЕсли А = "--no-watcher" Тогда
			Рез.Вставить("watcher", Ложь);
		ИначеЕсли А = "--help" ИЛИ А = "-h" Тогда
			Рез.Вставить("help", Истина);
		ИначеЕсли А = "--scenario" ИЛИ А = "--tags" ИЛИ А = "--feature"
		         ИЛИ А = "--platform" ИЛИ А = "--flavor" ИЛИ А = "--build"
		         ИЛИ А = "--language" Тогда
			ПредыдущийФлаг = А;
		ИначеЕсли Лев(А, 2) = "--" Тогда
			Сообщить("[ERROR] Неизвестная опция: " + А);
			ЗавершитьРаботу(1);
		Иначе
			// Значение для предыдущего флага
			Если ПредыдущийФлаг = "--scenario" Тогда
				Рез.Вставить("scenario", А);
			ИначеЕсли ПредыдущийФлаг = "--tags" Тогда
				Рез.Вставить("tags", А);
			ИначеЕсли ПредыдущийФлаг = "--feature" Тогда
				Рез["features"].Добавить(А);
			ИначеЕсли ПредыдущийФлаг = "--platform" Тогда
				// Может быть "a,b" → разбиваем
				Части = СтрРазделить(А, ",", Ложь);
				Для каждого Ч Из Части Цикл
					Рез["platforms"].Добавить(СокрЛП(Ч));
				КонецЦикла;
			ИначеЕсли ПредыдущийФлаг = "--flavor" Тогда
				Части = СтрРазделить(А, ",", Ложь);
				Для каждого Ч Из Части Цикл
					Рез["flavors"].Добавить(СокрЛП(Ч));
				КонецЦикла;
			ИначеЕсли ПредыдущийФлаг = "--build" Тогда
				Рез["builds"].Добавить(А);
			ИначеЕсли ПредыдущийФлаг = "--language" Тогда
				Рез.Вставить("language", А);
			Иначе
				Сообщить("[ERROR] Аргумент без флага: " + А);
				ЗавершитьРаботу(1);
			КонецЕсли;
			ПредыдущийФлаг = "";
		КонецЕсли;
	КонецЦикла;

	Возврат Рез;
КонецФункции

// ============================================================================
// Определение ячеек (platform × flavor combos)
// ============================================================================

// Вернуть массив Соответствий {platform, flavor, scenario, language}
Функция ОпределитьЯчейки(Знач Аргс, Знач СценарийДанные)
	Ячейки = Новый Массив;
	Язык   = Аргс["language"];

	// 1) Явные пары --build ver:flavor
	Если Аргс["builds"].Количество() > 0 Тогда
		Для каждого Пара Из Аргс["builds"] Цикл
			Части = СтрРазделить(Пара, ":", Ложь);
			Если Части.Количество() < 2 Тогда
				Сообщить("[ERROR] Неверный формат --build (ожидается ver:flavor): " + Пара);
				ЗавершитьРаботу(1);
			КонецЕсли;
			Яч = Новый Соответствие;
			Яч.Вставить("platform", СокрЛП(Части[0]));
			Яч.Вставить("flavor",   СокрЛП(Части[1]));
			Яч.Вставить("scenario", СценарийДанные);
			Яч.Вставить("language", Язык);
			Ячейки.Добавить(Яч);
		КонецЦикла;
		Возврат Ячейки;
	КонецЕсли;

	// 2) Явные --platform × --flavor (CLI перекрывает combos сценария)
	Платформы = Аргс["platforms"];
	Флейворы  = Аргс["flavors"];
	Если Платформы.Количество() > 0 ИЛИ Флейворы.Количество() > 0 Тогда
		Если Платформы.Количество() = 0 ИЛИ Флейворы.Количество() = 0 Тогда
			Сообщить("[ERROR] Укажите и --platform, и --flavor одновременно.");
			ЗавершитьРаботу(1);
		КонецЕсли;
		Для каждого П Из Платформы Цикл
			Для каждого Ф Из Флейворы Цикл
				Яч = Новый Соответствие;
				Яч.Вставить("platform", П);
				Яч.Вставить("flavor",   Ф);
				Яч.Вставить("scenario", СценарийДанные);
				Яч.Вставить("language", Язык);
				Ячейки.Добавить(Яч);
			КонецЦикла;
		КонецЦикла;
		Возврат Ячейки;
	КонецЕсли;

	// 3) combos/matrix из сценария (когда CLI-платформы не заданы)
	Если СценарийДанные <> Неопределено Тогда
		Комбо = СценарийДанные["combos"];
		Если Комбо <> Неопределено Тогда
			Для каждого К Из Комбо Цикл
				Яч = Новый Соответствие;
				Яч.Вставить("platform", К["platform"]);
				Яч.Вставить("flavor",   К["flavor"]);
				Яч.Вставить("scenario", СценарийДанные);
				Яч.Вставить("language", Язык);
				Ячейки.Добавить(Яч);
			КонецЦикла;
			Возврат Ячейки;
		КонецЕсли;
		Сообщить("[ERROR] Сценарий не содержит combos. Укажите --platform и --flavor.");
		ЗавершитьРаботу(1);
	КонецЕсли;

	// 4) Ни платформ, ни сценария — нужно хотя бы что-то
	Сообщить("[ERROR] Укажите --scenario (с combos) или --platform + --flavor или --build.");
	ЗавершитьРаботу(1);
	Возврат Ячейки; // никогда не достигается
КонецФункции

// ============================================================================
// Справка
// ============================================================================

Процедура ВывестиСправку()
	Сообщить("Использование:");
	Сообщить("  oscript tools/checks/check.os --scenario <s> [--platform <p>] [--flavor <f>] [опции]");
	Сообщить("  oscript tools/checks/check.os --build <ver:flavor> [--build …]          [опции]");
	Сообщить("  oscript tools/checks/check.os --tags ""@t1 @t2"" --platform <p> --flavor <f>  [опции]");
	Сообщить("  oscript tools/checks/check.os --list");
	Сообщить("");
	Сообщить("Опции:");
	Сообщить("  --scenario <s>       сценарий из scenarios/<s>.json (smoke, fast, regress, doc, …)");
	Сообщить("  --tags ""@t1 @t2""     ad-hoc теги → СписокТеговОтбор");
	Сообщить("  --feature <path>     конкретная .feature (можно несколько)");
	Сообщить("  --platform <ver,…>   платформы из platforms/<ver>.json (8.3.27, 8.5.1, …)");
	Сообщить("  --flavor <f,…>       флейворы из flavors/<f>.json (uf, web, nosync, …)");
	Сообщить("  --build <ver:flavor> явная пара (можно несколько)");
	Сообщить("  --language <ru|en>   языковая локаль (опционально)");
	Сообщить("  --watcher            включить Watcher (по умолчанию ON)");
	Сообщить("  --no-watcher         выключить Watcher");
	Сообщить("  --list               список сценариев/платформ/флейворов");
	Сообщить("  --dry-run            показать ячейки без запуска");
КонецПроцедуры

// ============================================================================
// MAIN
// ============================================================================

КаталогCheck = АбсолютныйПуть(ТекущийСценарий().Каталог);
КаталогTools = АбсолютныйПуть(КаталогCheck + "/..");

Если АргументыКоманднойСтроки.Количество() = 0 Тогда
	ВывестиСправку();
	ЗавершитьРаботу(1);
КонецЕсли;

Аргс = ПарсАргументов();

Если Аргс["help"] Тогда
	ВывестиСправку();
	ЗавершитьРаботу(0);
КонецЕсли;

Если Аргс["list"] Тогда
	ВывестиСписок();
	ЗавершитьРаботу(0);
КонецЕсли;

// Загружаем сценарий (если задан)
СценарийДанные = Неопределено;
Если Аргс["scenario"] <> "" Тогда
	СценарийДанные = ЗагрузитьДескриптор("scenarios", Аргс["scenario"]);
КонецЕсли;

// Дополнительные теги отбора из --tags
ТегиОтбораДоп = Новый Массив;
Если Аргс["tags"] <> "" Тогда
	ТегиОтбораДоп = РазобратьТеги(Аргс["tags"]);
КонецЕсли;

// Список фич из --feature
ФичиСписок = Аргс["features"];

// Ячейки
Ячейки = ОпределитьЯчейки(Аргс, СценарийДанные);

// --dry-run
Если Аргс["dryrun"] Тогда
	ВывестиDryRun(Ячейки, ТегиОтбораДоп, ФичиСписок,
	              Аргс["scenario"], Аргс["watcher"]);
КонецЕсли;

// ============================================================================
// Сборка build-файлов во временный каталог
// ============================================================================

ВременныйКаталог = ПолучитьИмяВременногоФайла("resolver-run");
СоздатьКаталог(ВременныйКаталог);

МассивСборок = Новый Массив;
Для каждого Яч Из Ячейки Цикл
	Для каждого Часть Из ЧастиСплита(Яч["scenario"], Яч["flavor"]) Цикл
		БилдДанные = СобратьBuild(Яч["platform"], Яч["flavor"], Яч["scenario"],
		                           ТегиОтбораДоп, ФичиСписок, Яч["language"], Часть);
		Суф = ?(Часть <> Неопределено, "_" + Часть["suffix"], "");
		ИмяФайла = ВременныйКаталог + "/build_" + Яч["platform"] + "_" + Яч["flavor"] + Суф + ".json";
		СохранитьJSONФайл(БилдДанные, ИмяФайла);
		МассивСборок.Добавить(АбсолютныйПуть(ИмяФайла));
	КонецЦикла;
КонецЦикла;

// КаталогиДляОчистки — как в существующих пресетах
КаталогиОчистки = Новый Массив;
КаталогиОчистки.Добавить(".\\ServiceBases\\allurereport");
КаталогиОчистки.Добавить(".\\ServiceBases\\cucumber");
КаталогиОчистки.Добавить(".\\ServiceBases\\junitreport");

// Top-level JSON
ТопЛевел = Новый Соответствие;
ТопЛевел.Вставить("КаталогиДляОчистки", КаталогиОчистки);
ТопЛевел.Вставить("ЗапускатьWatcher", Аргс["watcher"]);
ТопЛевел.Вставить("ВариантыСборок", МассивСборок);

ФайлТопЛевел = ВременныйКаталог + "/top-level.json";
СохранитьJSONФайл(ТопЛевел, ФайлТопЛевел);
АбсФайлТопЛевел = АбсолютныйПуть(ФайлТопЛевел);

Сообщить("[INFO] Подготовлено " + МассивСборок.Количество() + " сборок. Top-level: " + АбсФайлТопЛевел);

// ============================================================================
// Запуск через платформенную обёртку
// ============================================================================

Если ЭтоLinux() Тогда
	Обёртка = КаталогCheck + "/platform/linux/check.sh";
	Если НЕ (Новый Файл(Обёртка)).Существует() Тогда
		Сообщить("[ERROR] Не найдена Linux-обёртка: " + Обёртка);
		ЗавершитьРаботу(1);
	КонецЕсли;
	СтрокаКоманды = "sh " + Кавычка() + Обёртка + Кавычка()
		+ " " + Кавычка() + АбсФайлТопЛевел + Кавычка();
Иначе
	// Бэкслеши: cmd /c трактует "/platform" как ключи, если путь со смешанными слешами
	Обёртка = СтрЗаменить(КаталогCheck + "/platform/windows/check.cmd", "/", "\");
	Если НЕ (Новый Файл(Обёртка)).Существует() Тогда
		Сообщить("[ERROR] Не найдена Windows-обёртка: " + Обёртка);
		ЗавершитьРаботу(1);
	КонецЕсли;
	// cmd /c ""<обёртка>" "<top-level>""  — каноничное двойное экранирование
	СтрокаКоманды = "cmd /c " + Кавычка()
		+ Кавычка() + Обёртка + Кавычка()
		+ " " + Кавычка() + АбсФайлТопЛевел + Кавычка()
		+ Кавычка();
КонецЕсли;

Сообщить("[INFO] Запуск: " + СтрокаКоманды);
КодВозврата = -1;
ЗапуститьПриложение(СтрокаКоманды, , Истина, КодВозврата);
ЗавершитьРаботу(КодВозврата);
