#!/usr/bin/env oscript
#Использовать json

// tools/checks/check.os — universal entrypoint для запуска проверок.
//
// Использование:
//   oscript tools/checks/check.os <preset>            — запустить пресет
//   oscript tools/checks/check.os --list              — список доступных пресетов
//   oscript tools/checks/check.os --dry-run <preset>  — показать effective-config, не запускать
//
// <preset> — путь относительно presets/ (без .json), например:
//   smoke/8327-uf, fast/8327-uf, middle/8327-uf, web/8327, doc/default, main/default
//
// =============================================================================
// КОНТРАКТ ПУТЕЙ (важно — почему так, а не иначе)
// =============================================================================
// Конфиги в presets/ и builds/ используют пути относительно каталога tools/:
//   - presets/*.json → "ВариантыСборок": [".\\checks\\builds\\..."] (относительно tools/)
//   - builds/*.json  → "ПутьКVanessaAutomation": "./../vanessa-automation.epf" (относительно tools/),
//                      из которого runner вычисляет workspaceRoot = корень репо.
// Поэтому платформенная обёртка (platform/<ОС>/check.{cmd,sh}) ОБЯЗАНА запускать
// run-behavior-check-session.os с РАБОЧИМ КАТАЛОГОМ = tools/ (после compile.bat в корне репо).
// check.os передаёт обёртке АБСОЛЮТНЫЙ путь к пресету; внутренние ссылки резолвит обёртка
// за счёт корректного CWD. Поэтому переписывать пресет в temp-файл не требуется.

Перем КаталогCheck;    // .../tools/checks
Перем КаталогTools;    // .../tools
Перем КаталогPresets;  // .../tools/checks/presets

Функция ЭтоLinux()
	Попытка
		ТекущийТипПлатформы = Вычислить("(Новый СистемнаяИнформация).ТипПлатформы");
		Возврат ТекущийТипПлатформы <> Вычислить("ТипПлатформы.Windows_x86")
			И ТекущийТипПлатформы <> Вычислить("ТипПлатформы.Windows_x86_64");
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция АбсолютныйПуть(Знач Путь)
	Возврат (Новый Файл(Путь)).ПолноеИмя;
КонецФункции

Функция Кавычка()
	Возврат """";
КонецФункции

Функция ПрочитатьJSONФайл(Знач ИмяФайла)
	Чтение = Новый ЧтениеТекста(ИмяФайла, "UTF-8");
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();
	Парсер = Новый ПарсерJSON();
	Возврат Парсер.ПрочитатьJSON(Содержимое);
КонецФункции

Функция СписокПресетов()
	Результат = Новый Массив;
	Префикс = АбсолютныйПуть(КаталогPresets);
	Файлы = НайтиФайлы(Префикс, "*.json", Истина);
	Для каждого Ф Из Файлы Цикл
		Если НЕ Ф.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(Префикс) + 2);
		Отн = СтрЗаменить(Отн, "\", "/");
		Отн = Лев(Отн, СтрДлина(Отн) - СтрДлина(".json"));
		Результат.Добавить(Отн);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ВывестиСписокПресетов()
	Сообщить("Доступные пресеты:");
	Для каждого П Из СписокПресетов() Цикл
		Сообщить("  " + П);
	КонецЦикла;
КонецПроцедуры

Процедура ВывестиСправку()
	Сообщить("Использование:");
	Сообщить("  oscript tools/checks/check.os <preset>            запустить пресет");
	Сообщить("  oscript tools/checks/check.os --list              список пресетов");
	Сообщить("  oscript tools/checks/check.os --dry-run <preset>  показать конфиг без запуска");
	Сообщить("");
	Сообщить("Пример: oscript tools/checks/check.os middle/8327-uf");
КонецПроцедуры

// =============================================================================
// MAIN
// =============================================================================

КаталогCheck   = АбсолютныйПуть(ТекущийСценарий().Каталог);
КаталогTools   = АбсолютныйПуть(КаталогCheck + "/..");
КаталогPresets = КаталогCheck + "/presets";

Если АргументыКоманднойСтроки.Количество() = 0 Тогда
	ВывестиСправку();
	ЗавершитьРаботу(1);
КонецЕсли;

ИмяПресета = Неопределено;
ФлагDryRun = Ложь;
ФлагList   = Ложь;

Для каждого Арг Из АргументыКоманднойСтроки Цикл
	А = СтрЗаменить(Арг, Символ(13), "");
	Если А = "--list" Тогда
		ФлагList = Истина;
	ИначеЕсли А = "--dry-run" Тогда
		ФлагDryRun = Истина;
	ИначеЕсли Лев(А, 2) = "--" Тогда
		Сообщить("[ERROR] Неизвестная опция: " + А);
		ВывестиСправку();
		ЗавершитьРаботу(1);
	Иначе
		ИмяПресета = А;
	КонецЕсли;
КонецЦикла;

Если ФлагList Тогда
	ВывестиСписокПресетов();
	ЗавершитьРаботу(0);
КонецЕсли;

Если ИмяПресета = Неопределено Тогда
	Сообщить("[ERROR] Не указан пресет.");
	ВывестиСправку();
	Сообщить("");
	ВывестиСписокПресетов();
	ЗавершитьРаботу(1);
КонецЕсли;

ОтнПресет   = СтрЗаменить(ИмяПресета, "\", "/");
ПутьПресета = КаталогPresets + "/" + ОтнПресет + ".json";
ФайлПресета = Новый Файл(ПутьПресета);
Если НЕ ФайлПресета.Существует() Тогда
	Сообщить("[ERROR] Пресет не найден: " + ИмяПресета);
	Сообщить("        искал: " + ПутьПресета);
	Сообщить("");
	ВывестиСписокПресетов();
	ЗавершитьРаботу(1);
КонецЕсли;
АбсПутьПресета = ФайлПресета.ПолноеИмя;

// Валидация ВариантыСборок (резолв относительно tools/, как это сделает обёртка)
Попытка
	Данные = ПрочитатьJSONФайл(АбсПутьПресета);
Исключение
	Сообщить("[ERROR] Не удалось разобрать JSON пресета " + АбсПутьПресета + ": " + ОписаниеОшибки());
	ЗавершитьРаботу(1);
КонецПопытки;

МассивСборок = Данные["ВариантыСборок"];
Если МассивСборок = Неопределено Тогда
	Сообщить("[ERROR] В пресете нет поля 'ВариантыСборок': " + АбсПутьПресета);
	ЗавершитьРаботу(1);
КонецЕсли;

РазрешённыеСборки = Новый Массив;
КолвоОтсутствующих = 0;
Для каждого ОтнСборка Из МассивСборок Цикл
	АбсСборка = АбсолютныйПуть(КаталогTools + "/" + СтрЗаменить(ОтнСборка, "\", "/"));
	Существует = (Новый Файл(АбсСборка)).Существует();
	Если НЕ Существует Тогда
		КолвоОтсутствующих = КолвоОтсутствующих + 1;
	КонецЕсли;
	РазрешённыеСборки.Добавить(Новый Структура("Путь,Существует", АбсСборка, Существует));
КонецЦикла;

Если КолвоОтсутствующих > 0 Тогда
	Сообщить("[WARN] Не найдено файлов сборок: " + КолвоОтсутствующих + " (см. --dry-run)");
КонецЕсли;

Если ФлагDryRun Тогда
	Сообщить("Пресет:                  " + АбсПутьПресета);
	Сообщить("Рабочий каталог (CWD):   " + КаталогTools);
	Сообщить("ОС:                      " + ?(ЭтоLinux(), "linux", "windows"));
	Сообщить("ВариантыСборок (" + РазрешённыеСборки.Количество() + "):");
	Для каждого С Из РазрешённыеСборки Цикл
		Сообщить("  " + ?(С.Существует, "[ok]      ", "[MISSING] ") + С.Путь);
	КонецЦикла;
	ЗавершитьРаботу(0);
КонецЕсли;

// Запуск через платформенную обёртку (CWD внутри обёртки = tools/)
Если ЭтоLinux() Тогда
	Обёртка = КаталогCheck + "/platform/linux/check.sh";
	Если НЕ (Новый Файл(Обёртка)).Существует() Тогда
		Сообщить("[ERROR] Не найдена Linux-обёртка: " + Обёртка);
		ЗавершитьРаботу(1);
	КонецЕсли;
	СтрокаКоманды = "sh " + Кавычка() + Обёртка + Кавычка() + " " + Кавычка() + АбсПутьПресета + Кавычка();
Иначе
	Обёртка = КаталогCheck + "/platform/windows/check.cmd";
	Если НЕ (Новый Файл(Обёртка)).Существует() Тогда
		Сообщить("[ERROR] Не найдена Windows-обёртка: " + Обёртка);
		ЗавершитьРаботу(1);
	КонецЕсли;
	// cmd /c ""<обёртка>" "<пресет>""  — каноничное двойное экранирование для cmd.exe
	СтрокаКоманды = "cmd /c " + Кавычка() + Кавычка() + Обёртка + Кавычка()
		+ " " + Кавычка() + АбсПутьПресета + Кавычка() + Кавычка();
КонецЕсли;

Сообщить("[INFO] Запуск: " + СтрокаКоманды);
КодВозврата = -1;
ЗапуститьПриложение(СтрокаКоманды, , Истина, КодВозврата);
ЗавершитьРаботу(КодВозврата);
