#!/usr/bin/env oscript

// tools/checks/view-allure.os — universal entrypoint для просмотра Allure-отчёта.
// Эквивалент старого "3 ViewAllureReport.cmd".
//
// Использование:
//   oscript tools/checks/view-allure.os
//
// Без аргументов. Определяет ОС и дёргает platform/<ОС>/view-allure.{cmd|sh},
// которая генерирует и открывает Allure-отчёт из tools/ServiceBases/allurereport.
//
// Требует: allure CLI в PATH (https://github.com/allure-framework/allure2) + Java.

Функция ЭтоLinux()
	Попытка
		ТекущийТипПлатформы = Вычислить("(Новый СистемнаяИнформация).ТипПлатформы");
		Возврат ТекущийТипПлатформы <> Вычислить("ТипПлатформы.Windows_x86")
			И ТекущийТипПлатформы <> Вычислить("ТипПлатформы.Windows_x86_64");
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция АбсолютныйПуть(Знач Путь)
	Возврат (Новый Файл(Путь)).ПолноеИмя;
КонецФункции

Функция Кавычка()
	Возврат """";
КонецФункции

КаталогCheck = АбсолютныйПуть(ТекущийСценарий().Каталог);

Если ЭтоLinux() Тогда
	Обёртка = КаталогCheck + "/platform/linux/view-allure.sh";
	Если НЕ (Новый Файл(Обёртка)).Существует() Тогда
		Сообщить("[ERROR] Не найдена Linux-обёртка: " + Обёртка);
		ЗавершитьРаботу(1);
	КонецЕсли;
	СтрокаКоманды = "sh " + Кавычка() + Обёртка + Кавычка();
Иначе
	Обёртка = КаталогCheck + "/platform/windows/view-allure.cmd";
	Если НЕ (Новый Файл(Обёртка)).Существует() Тогда
		Сообщить("[ERROR] Не найдена Windows-обёртка: " + Обёртка);
		ЗавершитьРаботу(1);
	КонецЕсли;
	СтрокаКоманды = "cmd /c " + Кавычка() + Кавычка() + Обёртка + Кавычка() + Кавычка();
КонецЕсли;

Сообщить("[INFO] Запуск: " + СтрокаКоманды);
КодВозврата = -1;
ЗапуститьПриложение(СтрокаКоманды, , Истина, КодВозврата);
ЗавершитьРаботу(КодВозврата);
